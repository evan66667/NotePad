<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/app_background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/header_background"
        android:paddingLeft="16dp"
        android:paddingRight="12dp"
        android:paddingTop="12dp"
        android:paddingBottom="12dp">

        <EditText
            android:id="@+id/search_text"
            android:layout_width="0dp"
            android:layout_height="42dp"
            android:layout_weight="1"
            android:background="@drawable/search_field_background"
            android:drawableLeft="@android:drawable/ic_menu_search"
            android:drawablePadding="8dp"
            android:paddingLeft="14dp"
            android:paddingRight="14dp"
            android:hint="@string/search_hint"
            android:textColor="@color/title_text"
            android:textColorHint="@color/search_hint"
            android:textSize="15sp"
            android:singleLine="true"
            android:inputType="text"
            android:imeOptions="actionSearch" />

        <TextView
            android:id="@+id/clear_search"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginLeft="4dp"
            android:gravity="center"
            android:text="@string/search_clear_symbol"
            android:textColor="@android:color/white"
            android:textSize="18sp"
            android:clickable="true"
            android:focusable="true"
            android:background="?android:attr/selectableItemBackground"
            android:visibility="gone"
            android:contentDescription="@string/search_clear" />
    </LinearLayout>

    <GridView
        android:id="@+id/notes_grid"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:numColumns="2"
        android:horizontalSpacing="10dp"
        android:verticalSpacing="10dp"
        android:padding="12dp"
        android:clipToPadding="false"
        android:listSelector="@drawable/grid_selector"
        android:drawSelectorOnTop="true"
        android:cacheColorHint="@android:color/transparent"
        android:scrollbarStyle="outsideOverlay" />

    <LinearLayout
        android:id="@android:id/empty"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="24dp">

        <ImageView
            android:layout_width="76dp"
            android:layout_height="76dp"
            android:src="@drawable/app_notes"
            android:alpha="0.3"
            android:contentDescription="@string/empty_notes" />

        <TextView
            android:id="@+id/empty_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="@string/empty_notes"
            android:textColor="@color/title_text"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/empty_hint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/empty_notes_hint"
            android:textColor="@color/secondary_text"
            android:textSize="13sp" />

    </LinearLayout>

</LinearLayout>
